# =====================================================================
#  LAS FLORES · Conexión con Supabase
#  Supabase → Project Settings → API (o "API Keys")
# =====================================================================

# 1) Project URL  (ej: https://abcdefghijk.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=PEGA_AQUI_TU_PROJECT_URL

# 2) anon / public key  (en proyectos nuevos se llama "publishable key": sb_publishable_...)
#    La usa el inicio de sesión (Supabase Auth).
NEXT_PUBLIC_SUPABASE_ANON_KEY=PEGA_AQUI_TU_ANON_KEY

# 3) service_role key  (en proyectos nuevos se llama "secret key": sb_secret_...)
#    ¡SECRETA! Solo se usa en el servidor. Nunca la compartas.
SUPABASE_SERVICE_ROLE_KEY=PEGA_AQUI_TU_SERVICE_ROLE_KEY
